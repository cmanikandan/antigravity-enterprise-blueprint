# Python bytecode & caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/

# OS & Editor files
.DS_Store
.vscode/
.idea/

# Runtime state & logs
.agents/logs/
_agents/logs/
starter-kits/**/data/

# Never commit credentials or environment secrets
.env
.env.*
*.pem
*.key
*credentials*.json
*service_account*.json
